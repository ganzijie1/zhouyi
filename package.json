{
  "name": "yijing-math-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-reporter=spec test/unit/*.test.js",
    "test:syntax": "node scripts/check-test-syntax.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:performance": "node test/performance/sample-performance.mjs",
    "test:production": "npm run build && node scripts/check-production-bundle.mjs",
    "validate:classics": "node scripts/validate-classics.mjs",
    "generate:formal": "node scripts/generate-formal-artifacts.mjs",
    "validate:corpus": "node scripts/validate-corpus.mjs",
    "validate:formal": "node scripts/verify-derived-artifacts.mjs",
    "test:all": "npm run test && npm run test:production && npm run test:e2e"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
